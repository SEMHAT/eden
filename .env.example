# ─── EDEN : variables d'environnement ───
# Copiez ce fichier en .env pour le développement local. Ne mettez JAMAIS de vraie clé dans ce fichier.

# Base PostgreSQL. Sur Vercel, l'intégration Neon remplit ces deux variables automatiquement.
DATABASE_URL="postgresql://utilisateur:motdepasse@localhost:5432/eden"
# Connexion directe (sans pool), utilisée pour les migrations.
DATABASE_URL_UNPOOLED="postgresql://utilisateur:motdepasse@localhost:5432/eden"

# Secret de signature des sessions : 32 caractères minimum. Générer avec : openssl rand -base64 48
# Facultatif : à défaut, une clé est dérivée de DATABASE_URL. Recommandé en production.
AUTH_SECRET=""

# URL publique du site (Preview Vercel, puis https://eden.eledji.com)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mode démonstration : affiche le bandeau « données fictives ».
DEMO_MODE="true"

# Comptes créés par le script de données (seed). Laisser vide = mot de passe aléatoire affiché dans les logs du build.
SEED_ADMIN_EMAIL="admin@eden.demo"
SEED_ADMIN_PASSWORD=""
DEMO_PASSWORD=""
# SEED_FORCE="true"  # réinitialise le catalogue de démonstration (efface commandes et produits)

# Délai de réponse accordé à un vendeur avant de solliciter le suivant (minutes)
VENDOR_RESPONSE_MINUTES="120"

# Mentions légales imprimées sur les factures (raison sociale, RCCM, NIF, adresse)
EDEN_LEGAL_MENTIONS=""

# ─── Paiement (Mobile Money, carte) — à remplir quand le prestataire est choisi ───
# Tant que ces trois valeurs sont vides, seuls le paiement à la livraison est proposé.
PAYMENT_PROVIDER=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
